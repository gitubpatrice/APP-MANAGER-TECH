# keystore.properties.template
# -----------------------------------------------------------------------
# INSTRUCTIONS :
#   1. Copiez ce fichier en "keystore.properties" (sans .template)
#   2. Remplissez les 4 valeurs ci-dessous avec vos infos de keystore
#   3. NE COMMITTEZ JAMAIS keystore.properties — il est dans .gitignore
#   4. Générez votre keystore avec :
#      keytool -genkey -v -keystore app_manager_tech.jks \
#              -alias app_manager_tech -keyalg RSA \
#              -keysize 4096 -validity 10000
# -----------------------------------------------------------------------

storeFile=../app_manager_tech.jks
storePassword=CHANGE_ME
keyAlias=app_manager_tech
keyPassword=CHANGE_ME
