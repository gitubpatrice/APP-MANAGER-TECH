    <!-- Transparency screen (full disclosure of what App Manager Tech does on-device) -->
    <string name="screen_transparency_title">Transparency</string>
    <string name="transparency_intro">App Manager Tech is local-only. Below is the exhaustive list of what this app reads, what it stores, and what it sends. There is nothing else.</string>
    <string name="transparency_section_reads">What we read from your device</string>
    <string name="transparency_reads_packages">The list of installed apps (label, version, package name, install / update / last-used dates, install source, declared permissions, signing certificate). Source: Android PackageManager + StorageStatsManager + UsageStatsManager.</string>
    <string name="transparency_reads_sizes">App sizes: install / data / cache bytes per package. Requires PACKAGE_USAGE_STATS granted in OS Settings.</string>
    <string name="transparency_section_stores">What we store on your device</string>
    <string name="transparency_stores_room">A cache of the catalogue in a private SQLite database (Room). Refreshed by the background scan worker or on demand. Excluded from cloud backup.</string>
    <string name="transparency_stores_prefs">Your preferences (theme, scan cadence, ignore list, etc.) in DataStore Preferences. Excluded from cloud backup.</string>
    <string name="transparency_section_sends">What we send off your device</string>
    <string name="transparency_sends_nothing">Nothing. The app does not request the INTERNET permission. It cannot open a network socket — Android enforces this at the OS level.</string>
    <string name="transparency_section_third_parties">Third-party SDKs embedded</string>
    <string name="transparency_third_parties_none">Zero. No Google Mobile Services, no Firebase, no analytics, no crash reporter that phones home, no advertising library. Every dependency is open source under Apache 2.0 / MIT / BSD. Full list in THIRD_PARTY_NOTICES.</string>
    <string name="transparency_section_open_source">Open source</string>
    <string name="transparency_open_source_body">Source code, build recipe, threat model, and changelog are public on GitHub. Anyone can audit, reproduce the build byte-for-byte, fork, and redistribute under Apache 2.0.</string>
    <string name="transparency_link_privacy">Privacy Policy</string>
    <string name="transparency_link_terms">Terms of Use</string>
    <string name="transparency_link_security">Security model</string>
    <string name="transparency_link_third_parties">Third-party notices</string>

