<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Post-splash app theme. Compose owns the visual identity via
        AppManagerTechTheme; this XML style only has to keep the window
        chromeless and provide a sane background colour so there is no white
        flash on dark mode.
    -->
    <style name="Theme.AppManagerTech" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
        Splash theme (androidx.core.splashscreen compat for API 26–30; native
        SplashScreen API on 31+).

        v0.5.0 — the splash icon is `drawable/splash_icon`: the logo with
        rounded corners, inset to sit whole inside the circle the splash
        draws its icon in (as Agenda Tech). The launcher foreground used
        since v0.1.1 lost its corners in that circle and read as a disc.
        (Before v0.1.1, a transparent drawable made the splash invisible.)
    -->
    <style name="Theme.AppManagerTech.Splash" parent="Theme.SplashScreen">
        <!-- v0.1.2 — splash background WHITE per user feedback (was the
             brand blue ic_launcher_background, made the logo look "loud"). -->
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.AppManagerTech</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

</resources>
