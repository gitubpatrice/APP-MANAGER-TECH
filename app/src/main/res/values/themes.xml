<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Post-splash app theme. Compose owns the visual identity via
        AppManagerTechTheme; this XML style only has to keep the window
        chromeless and provide a sane background colour so there is no white
        flash on dark mode.
    -->
    <style name="Theme.AppManagerTech" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
        Splash theme (androidx.core.splashscreen compat for API 26–30; native
        SplashScreen API on 31+).

        v0.1.1 — the launcher icon foreground (inset 16% per side per the
        adaptive-icon safe zone) is reused as the splash icon so users see
        the brand logo for the ~600ms cold-start splash window. Previous
        builds used a transparent drawable copied from SMS Tech — that
        choice made the splash literally invisible and was reported as
        "no splash" by the first tester.
    -->
    <style name="Theme.AppManagerTech.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground_inset</item>
        <item name="postSplashScreenTheme">@style/Theme.AppManagerTech</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

</resources>
