<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ data extraction rules (cloud backup + device-to-device transfer).
    Mirrors backup_rules.xml for D2D transfer scenario.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_manager_tech_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_manager_tech_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
