<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-backup rules (Android 11 and below). allowBackup="false" already disables backup; these
    rules mirror data_extraction_rules.xml in case it is ever turned on: the settings DataStore and the
    Room database describe this device and must not be restored elsewhere.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
    <exclude domain="database" path="." />
</full-backup-content>
