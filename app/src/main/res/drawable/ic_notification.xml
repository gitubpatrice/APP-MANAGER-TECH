<?xml version="1.0" encoding="utf-8"?>
<!--
    Notification small icon — monochrome white-on-transparent vector.

    Android renders `setSmallIcon` as a single-tone shape regardless of fill
    colour, so any non-monochrome bitmap would appear washed out or blocky in
    the status bar. This 24dp vector is a stylised "app management" glyph
    (3 stacked rectangles, mirroring the launcher placeholder) at the canonical
    24dp notification size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M5,4 L19,4 Q20,4 20,5 L20,8 Q20,9 19,9 L5,9 Q4,9 4,8 L4,5 Q4,4 5,4 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M5,10 L19,10 Q20,10 20,11 L20,14 Q20,15 19,15 L5,15 Q4,15 4,14 L4,11 Q4,10 5,10 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M5,16 L19,16 Q20,16 20,17 L20,20 Q20,21 19,21 L5,21 Q4,21 4,20 L4,17 Q4,16 5,16 Z" />
</vector>
