<!--
  Files Tech checkered brand mark (v0.1.3 — replaces 500×500 PNG to fix
  audit P-1: PNG decoded to ~1 MB RGBA in memory just to be drawn at 28 dp).
  VectorDrawable is rendered directly at any size with zero rasterisation.

  Pattern: 2×2 squares with rounded outer corners.
  - top-left      : brand blue
  - top-right     : brand red
  - bottom-left   : brand red
  - bottom-right  : brand blue
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="500"
    android:viewportHeight="500">

    <!-- Top-left blue square (rounded top-left corner) -->
    <path
        android:fillColor="#0D6EFD"
        android:pathData="M40,0 L250,0 L250,250 L0,250 L0,40 A40,40 0 0,1 40,0 Z" />

    <!-- Top-right red square (rounded top-right corner) -->
    <path
        android:fillColor="#CB2129"
        android:pathData="M250,0 L460,0 A40,40 0 0,1 500,40 L500,250 L250,250 Z" />

    <!-- Bottom-left red square (rounded bottom-left corner) -->
    <path
        android:fillColor="#CB2129"
        android:pathData="M0,250 L250,250 L250,500 L40,500 A40,40 0 0,1 0,460 Z" />

    <!-- Bottom-right blue square (rounded bottom-right corner) -->
    <path
        android:fillColor="#0D6EFD"
        android:pathData="M250,250 L500,250 L500,460 A40,40 0 0,1 460,500 L250,500 Z" />
</vector>
