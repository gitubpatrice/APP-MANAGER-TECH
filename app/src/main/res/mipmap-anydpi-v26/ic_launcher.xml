<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+).

  background = brand colour from colors.xml.
  foreground = brand logo bitmap copied into mipmap-xxxhdpi/ic_launcher_foreground.png
               (Android scales down for lower densities).
  monochrome = same bitmap reused for Android 13+ themed icons (the launcher
               renders it as a single-tone shape).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
