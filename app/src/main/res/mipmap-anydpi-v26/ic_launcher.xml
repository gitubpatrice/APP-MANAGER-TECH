<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+).

  background = brand colour from colors.xml.
  foreground = brand logo bitmap wrapped in `@drawable/ic_launcher_foreground_inset`
               (16% inset per side, v0.1.1 fix — without this padding the
               launcher cropped the "App Manager Tech" text in the bitmap).
  monochrome = same wrapped bitmap reused for Android 13+ themed icons.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_inset" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground_inset" />
</adaptive-icon>
