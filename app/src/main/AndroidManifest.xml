<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        App Manager Tech — AndroidManifest.xml

        SD Maid-like app manager : declares all package-management permissions
        up front. Activation runtime is handled in Phase II (Accompanist).
    -->

    <!-- Query the full list of installed packages -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- UsageStats API — must be granted by the user in Settings -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Trigger uninstall via system intent (user confirms) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- StorageStatsManager : app size / cache / data -->
    <uses-permission android:name="android.permission.GET_PACKAGE_SIZE" />

    <!-- Stop background processes of foreign apps (normal-level permission, no runtime grant required) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"
        tools:ignore="ProtectedPermissions" />

    <!-- POST_NOTIFICATIONS — required from Android 13+ (API 33) to display the
         background-scan notifications. Runtime grant is requested on first use
         via Accompanist Permissions (Phase VIII Settings screen). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppManagerTech"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="${appLabel}"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.AppManagerTech.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            WorkManager on-demand initialisation.

            MainApplication implements androidx.work.Configuration.Provider so
            WorkManager picks up the HiltWorkerFactory from the DI graph at the
            first .getInstance(context) call. The default
            androidx.startup.InitializationProvider auto-init must therefore
            be removed, otherwise it bootstraps a second factory-less instance
            and the lint check `RemoveWorkManagerInitializer` blocks release
            builds. tools:node="remove" removes just the WorkManager startup
            entry, not the whole provider (other libraries may still use it).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
